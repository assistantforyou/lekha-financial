# Portfolio Terminal — secrets template
#
# Copy this file to ~/.config/portfolio-terminal/keys.env
# (Windows: %USERPROFILE%\.config\portfolio-terminal\keys.env)
# Fill in the values James sends you. Never commit this file.
#
# Start the dev server with:
#   set -a; source ~/.config/portfolio-terminal/keys.env; set +a; node scripts/dev-server.mjs 3456

# ---------------------------------------------------------------------------
# Supabase  [required for sign-in, accounts and saved state]
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Accounts  [required for admin features]
# Comma-separated list of emails allowed into the admin/costs pages.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=you@example.com

# Passphrase that gates the statement-import screen.
PT_IMPORT_PASSCODE=

# ---------------------------------------------------------------------------
# Cron  [required for the scheduled jobs; safe to make up locally]
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Brokerage — Alpaca  [required for live holdings/prices]
# https://app.alpaca.markets -> API Keys
# ---------------------------------------------------------------------------
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# ---------------------------------------------------------------------------
# Market data
# ---------------------------------------------------------------------------

# Alpha Vantage free key — https://www.alphavantage.co/support/#api-key
# Local launch config also accepts ALPHAVANTAGE_API_KEY and maps it to this.
AV_API_KEY=

# Twelve Data free key — https://twelvedata.com/account/api-keys
TWELVEDATA_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT=Portfolio Terminal you@example.com

# --- Unified financial data layer (api/_fin). Everything below is OPTIONAL: the app runs on the
# free set above (SEC, FRED, Alpaca, Yahoo, Twelve Data, Frankfurter, CoinGecko, RSS).
# Before enabling a paid plan read docs/INTEGRATION_AUDIT.md (display licensing differs per plan).
# SEC_USER_AGENT format: "AppName contact@example.com" (SEC requires a declared contact).

# Financial Modeling Prep: standardized statements, estimates, price targets, transcripts, screener.
# Free tier ~250 calls/day; showing FMP data publicly needs a paid plan with display rights.
FMP_API_KEY=

# Finnhub: quotes, company news, earnings calendar, recommendations. Free tier 60 calls/min.
FINNHUB_API_KEY=

# Not used today (keyless FRED CSV is enough). Set only if you switch macro to the FRED JSON API.
# FRED_API_KEY=

# Not integrated: no feature needs intraday trades, options or WebSockets (Massive/Polygon) or a
# paid news API yet. See docs/INTEGRATION_AUDIT.md.
# MASSIVE_API_KEY=
# NEWS_API_KEY=


# ---------------------------------------------------------------------------
# AI  [required for statement import, the news briefing and the research chat]
# DeepSeek is the only language-model provider. Key: https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# Optional AI overrides — leave as-is unless you know why you're changing them.
# DEEPSEEK_MODEL=deepseek-flash          # fast chat, statement import, news
# DEEPSEEK_DEEP_MODEL=deepseek-v4-pro    # Deep mode (tools and thinking)
# DEEPSEEK_VISION_MODEL=deepseek-flash   # page images and screenshots
# LLM_TEXT_MODEL=deepseek-flash          # statement text
# LLM_VISION_MODEL=deepseek-flash        # statement images
# NEWS_MODEL=deepseek-flash              # news briefing
# DEEPSEEK_DAILY_USD=5                   # hard daily spend cap; 0 disables the cap
# IMPORT_IP_DAILY_LIMIT=20               # per-connection statement imports per day

# Filing embeddings still use Gemini (768 dims; changing the model means re-embedding the
# whole corpus). Optional: without it, document search falls back to keyword matching.
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Optional limits / flags
# ---------------------------------------------------------------------------
# IMPORT_DAILY_LIMIT=
# AV_PREMIUM=

# ---------------------------------------------------------------------------
# Stripe — billing  [optional locally; only needed to test Premium checkout]
# Use TEST keys for local work, never live keys.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PRICE_PAID=
STRIPE_PRICE_PREMIUM=
STRIPE_LEGACY_PAID_PRICES=
STRIPE_LEGACY_PREMIUM_PRICES=
STRIPE_WEBHOOK_SECRET=

# Optional: public address that account e-mail links return to (confirm sign-up / reset password / confirm new address).
# Leave empty to use the address the request came in on (only lekhafinancial.com and *.vercel.app are accepted).
# Supabase must also allow it: Authentication > URL Configuration > Site URL and Redirect URLs.
SITE_URL=

# ---------------------------------------------------------------------------
# Product analytics — PostHog  [optional; the app runs unchanged without it]
# Project settings -> Project API key (starts with phc_) and the ingestion host.
# Set both in Vercel (Production and Preview) and in the local keys file to enable tracking.
# The key is public by design; it is served to the browser by GET /api/ph.
# ---------------------------------------------------------------------------
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional: link the project's PostHog UI (used for toolbar and replay links). Derived from POSTHOG_HOST by default.
# POSTHOG_UI_HOST=
# Set to 1 to stop all browser and server capture without removing the key.
# POSTHOG_DISABLED=
