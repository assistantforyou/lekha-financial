{
  "buildCommand": "node scripts/check-release-config.mjs --warn-only && npm run build:app",
  "outputDirectory": "public",
  "functions": {
    "api/ai.js": {
      "maxDuration": 300
    },
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/flows",
      "schedule": "30 23 * * 1-5"
    },
    {
      "path": "/api/cron/insiders?run=1",
      "schedule": "10 2 * * *"
    },
    {
      "path": "/api/cron/insiders?run=2",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/insiders?run=3",
      "schedule": "10 5 * * *"
    },
    {
      "path": "/api/cron/prune",
      "schedule": "45 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/v2",
      "destination": "/v2/index.html"
    },
    {
      "source": "/v3",
      "destination": "/v3/index.html"
    },
    {
      "source": "/api/free/:r*",
      "destination": "/api/free?__r=:r*"
    },
    {
      "source": "/api/av/:r*",
      "destination": "/api/av?__r=:r*"
    },
    {
      "source": "/api/billing/:r*",
      "destination": "/api/billing?__r=:r*"
    },
    {
      "source": "/api/ai/:r*",
      "destination": "/api/ai?__r=:r*"
    },
    {
      "source": "/api/cron/:r*",
      "destination": "/api/cron?__r=:r*"
    },
    {
      "source": "/api/data/:r*",
      "destination": "/api/data?__r=:r*"
    }
  ],
  "regions": [
    "hnd1"
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
